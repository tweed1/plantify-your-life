{
	"name": "api",
	"version": "1.0.0",
	"main": "main.js",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsup src/main.ts --watch --onSuccess 'node dist/main.js'",
		"start": "node --env-file .env dist/main.js",
		"build": "tsup src/main.ts --format esm --clean --minify --shims",
		"seed": "tsx --env-file .env src/import-data.ts",
        "seed-production": "tsx src/import-data.ts",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prisma format && prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:ui": "vitest --ui",
		"coverage": "vitest run --coverage",
		"gen-migration": "prisma migrate dev",
		"migrate": "prisma migrate deploy",
		"generate": "prisma generate",
		"studio": "prisma studio"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"type": "module",
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.3.0",
		"@types/stream-json": "^1.7.8",
		"dotenv": "^17.3.1",
		"prisma": "^7.4.1",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.4.1",
		"@prisma/client": "^7.4.1",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"remeda": "^2.33.6",
		"stream-chain": "^3.4.0",
		"stream-json": "^1.9.1"
	}
}
